APP_NAME="check-db"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8085

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Host names refer to the docker compose services.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=check_db
DB_USERNAME=check_adm
DB_PASSWORD=check_secret

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=log

# Largest accepted upload, in kilobytes.
DB_AUDIT_MAX_UPLOAD_KB=204800

VITE_APP_NAME="${APP_NAME}"
